pipeline {
	agent any
	
	stages {
		stage('Restore Dependencies in app') {
		when {
			anyOf {
				branch 'feature'
				branch 'main'
			}
		}
		steps {
				bat 'dotnet restore'
			}
		}		
		
		stage('Build the app') {
		when {
			anyOf {
				branch 'feature'
				branch 'main'
			}
		}
		steps {
				bat 'dotnet build --no-restore'
			}
		}
		
		stage('Test the app') {
		when {
			anyOf {
				branch 'feature'
				branch 'main'
			}
		}
		steps {
				bat 'dotnet test --no-build --verbosity normal'
			}
		}
	}
}
	